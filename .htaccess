# NOTA DE DESPLIEGUE
# Este archivo solo se aplica si el proyecto se aloja en Apache.
# GitHub Pages NO procesa .htaccess; sus cabeceras HTTP deben configurarse
# en la infraestructura que sirva la web.
#
# CABECERAS RECOMENDADAS PARA UN DESPLIEGUE APACHE

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self' https://forms.zohopublic.eu https://wa.link;"
</IfModule>
